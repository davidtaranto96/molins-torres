.DS_Store

# Los renders originales en PNG: 97 MB que el sitio NO usa (el HTML referencia
# sólo los .jpg). En git lo que entra queda en el historial para siempre.
*.png
# Menos las marcas, que son chicas y el sitio SÍ las usa. Sin esta excepción,
# `git add` las ignora sin decir nada y el sitio queda con dos imágenes rotas
# en producción: pasó el 2/9.
!img/logo-*.png
# y los iconos del sitio, que también son PNG chicos
!favicon-32.png
!apple-touch-icon.png

# La salida intermedia del transpilador. Se regenera con:
#   node scripts/transpilar.mjs
build/

# Lo que exporta Claude Design. Es la FUENTE del diseño, no el sitio: pesa 23 MB
# y duplica las imágenes que ya están en img/. Queda en la carpeta de trabajo.
Rediseño con datos pendientes/
*.zip

# Grabaciones de pantalla que David deja acá para que las analice: no se versionan.
*.mov
